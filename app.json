{
  "expo": {
    "name": "NanoChat",
    "slug": "litert-lm-chat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "nanochat",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nanochat.app.samsundar",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "NanoChat does not use your photo library."
      }
    },
    "plugins": [
      "react-native-litert-lm",
      [
        "expo-file-system",
        {}
      ],
      "./plugins/withFollyCoroutinesFix"
    ],
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    }
  }
}
