+//
+// LiteRTLMRegister.mm
+// react-native-litert-lm
+//
+// Registers the C++ HybridLiteRTLM stub with the Nitro Modules HybridObjectRegistry.
+// Using Objective-C +load ensures this runs before main() and cannot be dead-stripped
+// by the iOS linker (unlike C++ static initializers / __attribute__((constructor))).
+//
+
+#import <Foundation/Foundation.h>
+#import <NitroModules/HybridObjectRegistry.hpp>
+#import "HybridLiteRTLM.hpp"
+
+using namespace margelo::nitro;
+using namespace margelo::nitro::litertlm;
+
+@interface LiteRTLMRegister : NSObject
+@end
+
+@implementation LiteRTLMRegister
+
++ (void)load {
+  HybridObjectRegistry::registerHybridObjectConstructor(
+    "LiteRTLM",
+    []() -> std::shared_ptr<HybridObject> {
+      return std::make_shared<HybridLiteRTLM>();
+    }
+  );
+}
+
+@end
