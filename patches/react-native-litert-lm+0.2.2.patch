+// HybridLiteRTLM.mm
+// react-native-litert-lm
+//
+// iOS ObjC++ implementation that delegates to LiteRTLMBridge (Swift/LiteRT-LM SDK).
+// Compiled as Objective-C++ (.mm) so ObjC blocks and C++ can coexist.
+// Android uses the Kotlin implementation.
+//
+
+#import <Foundation/Foundation.h>
+
+#include "HybridLiteRTLM.hpp"
+#include "HybridLiteRTLMBridge.h"
+
+#include <stdexcept>
+#include <sstream>
+
+namespace margelo::nitro::litertlm {
+
+//------------------------------------------------------------------------------
+// loadModel — delegate to Swift bridge
+//------------------------------------------------------------------------------
+std::shared_ptr<Promise<void>> HybridLiteRTLM::loadModel(
+    const std::string& modelPath,
+    const std::optional<LLMConfig>& config) {
+
+  if (config.has_value()) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (config->backend.has_value())     backend_     = config->backend.value();
+    if (config->temperature.has_value()) temperature_ = config->temperature.value();
+    if (config->topK.has_value())        topK_        = config->topK.value();
+    if (config->topP.has_value())        topP_        = config->topP.value();
+    if (config->maxTokens.has_value())   maxTokens_   = config->maxTokens.value();
+    if (config->systemPrompt.has_value()) systemPrompt_ = config->systemPrompt.value();
+  }
+
+  bool useGPU = (backend_ == Backend::GPU);
+  std::string path = modelPath;
+
+  return Promise<void>::async([this, path, useGPU]() {
+    // LiteRTLMBridgeLoadModel is fully synchronous: blocks internally and
+    // calls our completion block BEFORE returning.
+    __block NSString* errNS = nil;
+
+    LiteRTLMBridgeLoadModel(path.c_str(), useGPU, ^(const char* err) {
+      if (err) errNS = @(err);  // @(cStr) creates NSString from C string
+    });
+    // Bridge has returned; loading is complete.
+
+    if (errNS) {
+      throw std::runtime_error(std::string("loadModel failed: ") + errNS.UTF8String);
+    }
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    isLoaded_ = true;
+    history_.clear();
+  });
+}
+
+//------------------------------------------------------------------------------
+// sendMessage — blocking, delegate to bridge
+//------------------------------------------------------------------------------
+std::shared_ptr<Promise<std::string>> HybridLiteRTLM::sendMessage(
+    const std::string& message) {
+
+  std::string prompt = message;  // capture by value for the async lambda
+
+  return Promise<std::string>::async([this, prompt]() -> std::string {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      ensureLoaded();
+    }
+
+    // LiteRTLMBridgeSendMessage is fully synchronous: blocks internally and
+    // calls our completion block BEFORE returning.
+    __block NSString* resultNS = nil;
+    __block NSString* errNS = nil;
+
+    LiteRTLMBridgeSendMessage(prompt.c_str(), ^(const char* text, const char* err) {
+      if (text) resultNS = @(text);
+      if (err)  errNS    = @(err);
+    });
+    // Bridge has returned.
+
+    if (errNS) {
+      throw std::runtime_error(std::string("sendMessage failed: ") + errNS.UTF8String);
+    }
+
+    std::string response = resultNS ? std::string(resultNS.UTF8String) : "";
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    Message userMsg;
+    userMsg.role = Role::USER;
+    userMsg.content = prompt;
+    history_.push_back(userMsg);
+    Message modelMsg;
+    modelMsg.role = Role::MODEL;
+    modelMsg.content = response;
+    history_.push_back(modelMsg);
+
+    return response;
+  });
+}
+
+//------------------------------------------------------------------------------
+// sendMessageWithImage — Not supported on iOS.
+//------------------------------------------------------------------------------
+std::shared_ptr<Promise<std::string>> HybridLiteRTLM::sendMessageWithImage(
+    const std::string& /* message */,
+    const std::string& /* imagePath */) {
+
+  return Promise<std::string>::rejected(
+      std::make_exception_ptr(std::runtime_error(
+          "sendMessageWithImage is not yet supported on iOS.")));
+}
+
+//------------------------------------------------------------------------------
+// downloadModel — Not supported via this API on iOS.
+//------------------------------------------------------------------------------
+std::shared_ptr<Promise<std::string>> HybridLiteRTLM::downloadModel(
+    const std::string& /* url */,
+    const std::string& /* fileName */,
+    const std::optional<std::function<void(double)>>& /* onProgress */) {
+
+  return Promise<std::string>::rejected(
+      std::make_exception_ptr(std::runtime_error(
+          "downloadModel is not supported on iOS via react-native-litert-lm. "
+          "Use expo-file-system to download models.")));
+}
+
+//------------------------------------------------------------------------------
+// deleteModel — Not supported on iOS.
+//------------------------------------------------------------------------------
+std::shared_ptr<Promise<void>> HybridLiteRTLM::deleteModel(
+    const std::string& /* fileName */) {
+
+  return Promise<void>::rejected(
+      std::make_exception_ptr(std::runtime_error(
+          "deleteModel is not supported on iOS.")));
+}
+
+//------------------------------------------------------------------------------
+// sendMessageWithAudio — Not supported on iOS.
+//------------------------------------------------------------------------------
+std::shared_ptr<Promise<std::string>> HybridLiteRTLM::sendMessageWithAudio(
+    const std::string& /* message */,
+    const std::string& /* audioPath */) {
+
+  return Promise<std::string>::rejected(
+      std::make_exception_ptr(std::runtime_error(
+          "sendMessageWithAudio is not yet supported on iOS.")));
+}
+
+//------------------------------------------------------------------------------
+// sendMessageAsync — Streaming via LiteRTLMBridge
+//------------------------------------------------------------------------------
+void HybridLiteRTLM::sendMessageAsync(
+    const std::string& message,
+    const std::function<void(const std::string& /* token */, bool /* done */)>& onToken) {
+
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ensureLoaded();
+  }
+
+  std::string prompt = message;
+
+  // Add user message to history before streaming
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    Message userMsg;
+    userMsg.role = Role::USER;
+    userMsg.content = prompt;
+    history_.push_back(userMsg);
+  }
+
+  // Capture onToken for use in ObjC block.
+  // ObjC blocks can't mutate captured C++ objects directly — use shared_ptr wrappers
+  // so the block holds a pointer it can freely dereference and modify.
+  auto spFullResponse  = std::make_shared<std::string>();
+  auto spTokenCallback = std::make_shared<std::function<void(const std::string&, bool)>>(onToken);
+
+  __block std::string errorMsg;
+
+  // Capture raw pointers from shared_ptrs for the block.
+  // Lifetime is safe: bridge is synchronous, all callbacks fire before it returns.
+  std::string* pFullResponse  = spFullResponse.get();
+  auto*        pTokenCallback = spTokenCallback.get();
+
+  LiteRTLMBridgeSendMessageAsync(
+    prompt.c_str(),
+    ^(const char* token) {
+      // Called for each streamed token
+      if (token && token[0] != '\0') {
+        *pFullResponse += token;
+        (*pTokenCallback)(std::string(token), false);
+      }
+    },
+    ^(const char* err) {
+      // Called when streaming completes (err is null on success)
+      if (err) errorMsg = std::string(err);
+    }
+  );
+
+  // LiteRTLMBridgeSendMessageAsync is fully synchronous: it blocks internally
+  // via DispatchSemaphore until all tokens are streamed, then returns.
+  // All onToken callbacks have already fired before this line is reached.
+
+  // Signal end of stream to JS
+  if (errorMsg.empty()) {
+    (*pTokenCallback)("", true);  // done signal
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    Message modelMsg;
+    modelMsg.role = Role::MODEL;
+    modelMsg.content = *spFullResponse;
+    history_.push_back(modelMsg);
+  } else {
+    // Surface the native error to JS instead of silently reporting 0 tokens.
+    (*pTokenCallback)(std::string("[Native error] ") + errorMsg, false);
+    (*pTokenCallback)("", true);
+    // Remove the user message we added since generation failed
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!history_.empty()) history_.pop_back();
+  }
+}
+
+//------------------------------------------------------------------------------
+// getHistory
+//------------------------------------------------------------------------------
+std::vector<Message> HybridLiteRTLM::getHistory() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return history_;
+}
+
+//------------------------------------------------------------------------------
+// resetConversation
+//------------------------------------------------------------------------------
+void HybridLiteRTLM::resetConversation() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  history_.clear();
+  LiteRTLMBridgeResetConversation();
+}
+
+//------------------------------------------------------------------------------
+// isReady
+//------------------------------------------------------------------------------
+bool HybridLiteRTLM::isReady() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return isLoaded_ && LiteRTLMBridgeIsReady();
+}
+
+//------------------------------------------------------------------------------
+// getStats
+//------------------------------------------------------------------------------
+GenerationStats HybridLiteRTLM::getStats() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return lastStats_;
+}
+
+//------------------------------------------------------------------------------
+// getMemoryUsage — Real OS-level memory query on Apple platforms.
+//------------------------------------------------------------------------------
+MemoryUsage HybridLiteRTLM::getMemoryUsage() {
+  double nativeHeapBytes = 0;
+  double residentBytes = 0;
+  double availableMemoryBytes = 0;
+  bool isLowMemory = false;
+
+#ifdef __APPLE__
+  struct mach_task_basic_info taskInfo;
+  mach_msg_type_number_t infoCount = MACH_TASK_BASIC_INFO_COUNT;
+  if (task_info(mach_task_self(), MACH_TASK_BASIC_INFO,
+                reinterpret_cast<task_info_t>(&taskInfo), &infoCount) == KERN_SUCCESS) {
+    residentBytes = static_cast<double>(taskInfo.resident_size);
+    nativeHeapBytes = residentBytes;
+  }
+
+  vm_statistics64_data_t vmStats;
+  mach_msg_type_number_t vmCount = HOST_VM_INFO64_COUNT;
+  if (host_statistics64(mach_host_self(), HOST_VM_INFO64,
+                        reinterpret_cast<host_info64_t>(&vmStats), &vmCount) == KERN_SUCCESS) {
+    vm_size_t pageSize;
+    host_page_size(mach_host_self(), &pageSize);
+    availableMemoryBytes = static_cast<double>(vmStats.free_count) * pageSize;
+    uint64_t totalPages = vmStats.active_count + vmStats.inactive_count + vmStats.free_count;
+    isLowMemory = (totalPages > 0) &&
+                  (static_cast<double>(vmStats.free_count) / totalPages < 0.1);
+  }
+#endif
+
+  return MemoryUsage{nativeHeapBytes, residentBytes, availableMemoryBytes, isLowMemory};
+}
+
+//------------------------------------------------------------------------------
+// close
+//------------------------------------------------------------------------------
+void HybridLiteRTLM::close() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  isLoaded_ = false;
+  history_.clear();
+  LiteRTLMBridgeClose();
+}
+
+} // namespace margelo::nitro::litertlm
