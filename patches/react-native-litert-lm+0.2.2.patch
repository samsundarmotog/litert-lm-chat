@@ -0,0 +1,53 @@
+//
+// HybridLiteRTLMBridge.h
+// react-native-litert-lm
+//
+// C-callable bridge from HybridLiteRTLM.cpp (C++) to LiteRTLMBridge.swift.
+// Implemented in HybridLiteRTLMBridge.mm (Objective-C++).
+//
+
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#include <stdbool.h>
+
+/// Load a model from the given path. Calls completion on the calling thread when done.
+/// @param modelPath  Absolute path to a .litertlm file.
+/// @param useGPU     true = Metal GPU backend, false = CPU.
+/// @param completion Called with NULL on success, or a C-string error message on failure.
+void LiteRTLMBridgeLoadModel(
+    const char* modelPath,
+    bool useGPU,
+    void (^completion)(const char* __nullable errorMessage));
+
+/// Send a message and get the full response synchronously.
+/// @param prompt      The user message text.
+/// @param completion  Called with (responseText, NULL) on success, or (NULL, errorMessage) on failure.
+void LiteRTLMBridgeSendMessage(
+    const char* prompt,
+    void (^completion)(const char* __nullable responseText, const char* __nullable errorMessage));
+
+/// Send a message with streaming token callbacks.
+/// @param prompt       The user message text.
+/// @param onToken      Called with each token string (non-null, non-empty).
+/// @param onComplete   Called when streaming ends. NULL errorMessage = success.
+void LiteRTLMBridgeSendMessageAsync(
+    const char* prompt,
+    void (^onToken)(const char* __nonnull token),
+    void (^onComplete)(const char* __nullable errorMessage));
+
+/// Returns true if the engine and conversation are initialized.
+bool LiteRTLMBridgeIsReady(void);
+
+/// Reset the conversation (clears KV cache, keeps engine loaded).
+void LiteRTLMBridgeResetConversation(void);
+
+/// Close the engine and release GPU/CPU memory.
+void LiteRTLMBridgeClose(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/node_modules/react-native-litert-lm/ios/HybridLiteRTLMBridge.mm b/node_modules/react-native-litert-lm/ios/HybridLiteRTLMBridge.mm
new file mode 100644
index 0000000..4a569d7
--- /dev/null
+++ b/node_modules/react-native-litert-lm/ios/HybridLiteRTLMBridge.mm
@@ -0,0 +1,134 @@
+//
+// HybridLiteRTLMBridge.mm
+// react-native-litert-lm
+//
+// C-bridge implementation using the ObjC runtime to call LiteRTLMBridge.swift
+// (which lives in the NanoChat app target).
+//
+// We use objc_msgSend to call the @objc-annotated methods on LiteRTLMBridge at runtime,
+// so there is NO compile-time dependency on the app target's Swift-generated headers.
+// This is the standard pattern for plugin/pod → host-app communication on iOS.
+//
+
+#import "HybridLiteRTLMBridge.h"
+
+#import <Foundation/Foundation.h>
+#import <objc/runtime.h>
+#import <objc/message.h>
+
+// ---------------------------------------------------------------------------
+// Helper: Get the LiteRTLMBridge singleton (defined in LiteRTLMBridge.swift)
+// ---------------------------------------------------------------------------
+static id _Nullable getSharedBridge(void) {
+  // LiteRTLMBridge is an @objc class, so it's registered in the ObjC runtime.
+  Class cls = objc_getClass("LiteRTLMBridge");
+  if (!cls) {
+    NSLog(@"[LiteRTLMBridge] ERROR: LiteRTLMBridge class not found in ObjC runtime. "
+          @"Make sure LiteRTLMBridge.swift is compiled into the app target.");
+    return nil;
+  }
+  // Call [LiteRTLMBridge shared] — a class property, maps to +shared selector.
+  return ((id (*)(id, SEL))objc_msgSend)(cls, NSSelectorFromString(@"shared"));
+}
+
+// ---------------------------------------------------------------------------
+// Function pointer typedefs matching LiteRTLMBridge's @objc method signatures
+// ---------------------------------------------------------------------------
+
+// - (void)loadModelWithModelPath:(NSString*)path useGPU:(BOOL)useGPU completion:(void(^)(NSError*))completion;
+typedef void (*LoadModelIMP)(id, SEL, NSString*, BOOL, void(^)(NSError* _Nullable));
+
+// - (void)sendMessageWithPrompt:(NSString*)prompt completion:(void(^)(NSString*, NSError*))completion;
+typedef void (*SendMessageIMP)(id, SEL, NSString*, void(^)(NSString* _Nullable, NSError* _Nullable));
+
+// - (void)sendMessageAsyncWithPrompt:(NSString*)prompt onToken:(void(^)(NSString*))onToken onComplete:(void(^)(id, NSError*))onComplete;
+typedef void (*SendMessageAsyncIMP)(id, SEL, NSString*, void(^)(NSString*), void(^)(id _Nullable, NSError* _Nullable));
+
+// - (BOOL)isReady;
+typedef BOOL (*IsReadyIMP)(id, SEL);
+
+// - (void)resetConversation;
+typedef void (*ResetConversationIMP)(id, SEL);
+
+// - (void)close;
+typedef void (*CloseIMP)(id, SEL);
+
+// ---------------------------------------------------------------------------
+// Bridge function implementations
+// ---------------------------------------------------------------------------
+
+void LiteRTLMBridgeLoadModel(
+    const char* modelPath,
+    bool useGPU,
+    void (^completion)(const char* _Nullable errorMessage))
+{
+  id bridge = getSharedBridge();
+  if (!bridge) { completion("LiteRTLMBridge not available"); return; }
+
+  NSString* path = [NSString stringWithUTF8String:modelPath ?: ""];
+  SEL sel = NSSelectorFromString(@"loadModelWithModelPath:useGPU:completion:");
+  LoadModelIMP imp = (LoadModelIMP)objc_msgSend;
+  imp(bridge, sel, path, (BOOL)useGPU, ^(NSError* error) {
+    completion(error ? error.localizedDescription.UTF8String : NULL);
+  });
+}
+
+void LiteRTLMBridgeSendMessage(
+    const char* prompt,
+    void (^completion)(const char* _Nullable responseText, const char* _Nullable errorMessage))
+{
+  id bridge = getSharedBridge();
+  if (!bridge) { completion(NULL, "LiteRTLMBridge not available"); return; }
+
+  NSString* promptStr = [NSString stringWithUTF8String:prompt ?: ""];
+  SEL sel = NSSelectorFromString(@"sendMessageWithPrompt:completion:");
+  SendMessageIMP imp = (SendMessageIMP)objc_msgSend;
+  imp(bridge, sel, promptStr, ^(NSString* text, NSError* error) {
+    completion(text ? text.UTF8String : NULL,
+               error ? error.localizedDescription.UTF8String : NULL);
+  });
+}
+
+void LiteRTLMBridgeSendMessageAsync(
+    const char* prompt,
+    void (^onToken)(const char* _Nonnull token),
+    void (^onComplete)(const char* _Nullable errorMessage))
+{
+  id bridge = getSharedBridge();
+  if (!bridge) { onComplete("LiteRTLMBridge not available"); return; }
+
+  NSString* promptStr = [NSString stringWithUTF8String:prompt ?: ""];
+  SEL sel = NSSelectorFromString(@"sendMessageAsyncWithPrompt:onToken:onComplete:");
+  SendMessageAsyncIMP imp = (SendMessageAsyncIMP)objc_msgSend;
+  imp(bridge, sel, promptStr,
+      ^(NSString* token) {
+        if (token.length > 0) onToken(token.UTF8String);
+      },
+      ^(id stats, NSError* error) {
+        onComplete(error ? error.localizedDescription.UTF8String : NULL);
+      });
+}
+
+bool LiteRTLMBridgeIsReady(void) {
+  id bridge = getSharedBridge();
+  if (!bridge) return false;
+  SEL sel = NSSelectorFromString(@"isReady");
+  IsReadyIMP imp = (IsReadyIMP)objc_msgSend;
+  return (bool)imp(bridge, sel);
+}
+
+void LiteRTLMBridgeResetConversation(void) {
+  id bridge = getSharedBridge();
+  if (!bridge) return;
+  SEL sel = NSSelectorFromString(@"resetConversation");
+  ResetConversationIMP imp = (ResetConversationIMP)objc_msgSend;
+  imp(bridge, sel);
+}
+
+void LiteRTLMBridgeClose(void) {
+  id bridge = getSharedBridge();
+  if (!bridge) return;
+  SEL sel = NSSelectorFromString(@"close");
+  CloseIMP imp = (CloseIMP)objc_msgSend;
+  imp(bridge, sel);
+}
